<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Title and status -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Upcoming"
                android:textColor="@color/quiz_app_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvQuizTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/tvStatusBadge"
                android:layout_alignParentStart="true"
                android:text="General Science Quiz"
                android:textColor= "@color/quiz_app_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- basic info -->
        <TextView
            android:id="@+id/tvQuizCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Category: History"
            android:textColor="@color/quiz_app_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvQuizDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Difficulty: Easy"
            android:textColor="@color/quiz_app_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvQuizQuestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Questions: 10"
            android:textColor="@color/quiz_app_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvQuizDateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Date: 06/10/2026 - 14/10/2026"
            android:textColor="@color/quiz_app_text_primary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="5dp"
            android:background="@color/quiz_app_text_tertiary" />

        <!-- Rating Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRatingScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 4.5"
                android:textColor="@color/quiz_app_star"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubmissionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="(45 Submissions)"
                android:textColor="@color/quiz_app_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartQuiz"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="Start"
                android:textColor="@color/quiz_app_primary"
                app:strokeColor="@color/quiz_app_primary" />

            <Button
                android:id="@+id/btnEditQuiz"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="Edit"
                android:textColor="@color/quiz_app_primary"
                app:strokeColor="@color/quiz_app_primary" />

            <Button
                android:id="@+id/btnDeleteQuiz"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Delete"
                android:textColor="@color/quiz_app_error"
                app:strokeColor="@color/quiz_app_error" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>