<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/tvHistoryBadge"
                android:layout_alignParentStart="true"
                android:text="General Science Quiz"
                android:textColor="@color/quiz_app_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Completed"
                android:textColor="@color/quiz_app_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvQuizCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Category: History"
            android:textColor="@color/quiz_app_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvQuizDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Difficulty: Easy"
            android:textColor="@color/quiz_app_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvQuizType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Type: Multiple Choice"
            android:textColor="@color/quiz_app_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvHistoryScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Score: 8 / 10"
            android:textColor="@color/quiz_app_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Completed on: 17/10/2026 22:51"
            android:textColor="@color/quiz_app_text_primary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/quiz_app_text_tertiary" />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnViewQuiz"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="VIEW ANSWERS"
                android:textColor="@color/quiz_app_primary"
                app:strokeColor="@color/quiz_app_primary"
                android:layout_alignParentStart="true"/>

            <Button
                android:id="@+id/btnDeleteQuiz"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="DELETE"
                android:textColor="@color/quiz_app_error"
                app:strokeColor="@color/quiz_app_error"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>


    </LinearLayout>
</androidx.cardview.widget.CardView>